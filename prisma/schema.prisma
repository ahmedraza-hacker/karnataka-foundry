generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  REVIEWING
  QUOTED
  CLOSED
}

enum CompanyRole {
  BUYER
  SUPPLIER
  BOTH
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductVisibility {
  PUBLIC
  APPROVED_BUYERS
  SELECTED_COMPANIES
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  sku               String   @unique
  category          String
  material          String?
  outerDiameterMm   Float?
  innerDiameterMm   Float?
  overallDimensions String?
  bladeCount        Int?
  compatibleFrames  String?
  description       String
  minimumOrderQty   Int      @default(1)
  price             Decimal? @db.Decimal(12, 2)
  imageUrl          String?
  isSample          Boolean  @default(true)
  visibility        ProductVisibility @default(PUBLIC)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companyAccess CompanyProductAccess[]

  @@index([category])
}

model Company {
  id                   String        @id @default(cuid())
  companyName          String
  contactName          String
  email                String        @unique
  phone                String
  passwordHash         String
  requestedRole        CompanyRole
  role                 CompanyRole?
  status               CompanyStatus @default(PENDING)
  city                 String
  state                String
  gstin                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  productAccess        CompanyProductAccess[]

  @@index([status, createdAt])
}

model CompanyProductAccess {
  companyId String
  productId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([companyId, productId])
  @@index([productId])
}

model RegistrationRateLimit {
  ipHash          String   @id
  windowStartedAt DateTime
  attempts        Int      @default(1)
}

model Enquiry {
  id                 String        @id @default(cuid())
  customerName       String
  companyName        String
  email              String
  phone              String
  productReference   String?
  quantity           Int?
  applicationDetails String?
  technicalNeeds     String?
  message            String?
  status             EnquiryStatus @default(NEW)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
