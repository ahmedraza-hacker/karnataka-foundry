generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  REVIEWING
  QUOTED
  CLOSED
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  sku               String   @unique
  category          String
  material          String?
  outerDiameterMm   Float?
  innerDiameterMm   Float?
  overallDimensions String?
  bladeCount        Int?
  compatibleFrames  String?
  description       String
  minimumOrderQty   Int      @default(1)
  price             Decimal? @db.Decimal(12, 2)
  imageUrl          String?
  isSample          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
}

model Enquiry {
  id                 String        @id @default(cuid())
  customerName       String
  companyName        String
  email              String
  phone              String
  productReference   String?
  quantity           Int?
  applicationDetails String?
  technicalNeeds     String?
  message            String?
  status             EnquiryStatus @default(NEW)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
