# PostgreSQL connection string for local development and deployment.
# Set these private values before enabling admin login. Keep AUTH_SECRET stable
# across deployments because registration rate-limit keys depend on it.
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH_B64=""
BLOB_READ_WRITE_TOKEN=""
# Token for a separate private Vercel Blob store used by restricted product images.
BLOB_PRIVATE_READ_WRITE_TOKEN=""
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/karnataka_foundry?schema=public"
